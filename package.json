{
  "name": "cube-solver",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only puzzle solver for 2×2–15×15 cubes, Pyraminx, Skewb and Megaminx, with a permutation-graph visualization",
  "scripts": {
    "start": "node tests/serve.js 8765",
    "build": "node tools/build-dist.js",
    "build:seo": "node tools/build-seo.js",
    "build:seo-images": "node tools/build-seo-images.js http://localhost:8765",
    "build:tables": "node tools/build-tables.js",
    "pretest": "node tools/build-seo.js",
    "test": "node tests/model.test.js && node tests/plugin.test.js && node tests/worker.test.js && node tests/audio.test.js && node tests/i18n.unit.test.js && node tests/tables.test.js && node tests/play.unit.test.js && node tests/twisty.test.js 200 && node tests/megaminx.test.js && node tests/scan-synth.test.js 10 2,3,4,5 && node tests/analytics.unit.test.js && node tests/share-code.test.js && node tests/seo.test.js",
    "test:nxn": "node tests/nxn.test.js 12 && node tests/gullicube.test.js 5,7,10,15 both",
    "test:scan": "node tests/scan-synth.test.js 40 2,3,4,5,6,7,9,11,15",
    "test:e2e": "node tests/e2e.test.js http://localhost:8765/",
    "test:i18n": "node tests/i18n.test.js http://localhost:8765/",
    "test:play": "node tests/play.e2e.js http://localhost:8765/",
    "test:twisty": "node tests/twisty.e2e.js http://localhost:8765/",
    "test:naming": "node tests/naming.e2e.js http://localhost:8765/",
    "test:topbar": "node tests/topbar.e2e.js http://localhost:8765/",
    "test:analytics": "node tests/analytics.e2e.js https://cube-solver.org/ --proxy http://localhost:8765 --stub",
    "test:analytics:live": "node tests/analytics.e2e.js https://cube-solver.org/",
    "test:seo:live": "node tests/seo.test.js https://cube-solver.org",
    "deploy": "npm run build && wrangler deploy -c deploy/wrangler.toml",
    "test:features": "node tests/features.e2e.js http://localhost:8765/",
    "build:three": "node tools/build-three.js",
    "test:dist": "node tests/dist.e2e.js http://localhost:8766/"
  },
  "license": "MIT",
  "homepage": "https://cube-solver.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/neichen/cube-solver.git"
  },
  "bugs": {
    "url": "https://github.com/neichen/cube-solver/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "three": "0.160.0",
    "wrangler": "^4.152.0"
  }
}
